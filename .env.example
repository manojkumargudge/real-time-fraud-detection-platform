# Copy to .env (gitignored) and replace every placeholder. Never commit .env.
POSTGRES_PASSWORD=change-me
# Host ports (container ports stay 5432 / 8000). Defaults avoid a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=15432
API_HOST_PORT=18000
# API key for POST /score (X-API-Key header), at least 16 characters. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-random-key
# Dashboard sign-in: comma-separated name:<bcrypt hash> entries, made with
#   python -m src.dashboard.auth hash NAME      (prompts for the password; prints the entry)
# Keep the single quotes: the hashes contain $ which Compose would otherwise interpolate.
DASHBOARD_USERS='name:paste-the-bcrypt-hash-here'
