FROM postgres:16.16-alpine3.24@sha256:9d9e487c1bd6413c52ccb3c02f46c8e37fa1e1d1a32a84519eb4e68d0ad1da30

# Apply the Alpine libxml2 security patch while retaining PostgreSQL 16.16.
RUN apk add --no-cache --upgrade 'libxml2>=2.13.9-r3'

# The official entrypoint calls `gosu postgres COMMAND`. Use Alpine's privilege
# drop helper at that path so the old statically linked Go executable is absent.
RUN apk add --no-cache su-exec \
    && test -x /sbin/su-exec \
    && rm /usr/local/bin/gosu \
    && cp /sbin/su-exec /usr/local/bin/gosu \
    && cmp /sbin/su-exec /usr/local/bin/gosu \
    && test "$(gosu postgres id -un)" = postgres
