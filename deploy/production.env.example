# Copy to a file outside the checkout with mode 0600 before filling in values.
# Use independent random values (openssl rand -hex 32) for the three secrets.
# Use hex for POSTGRES_PASSWORD because it is interpolated into a database URI.
POSTGRES_PASSWORD=
API_KEY=
DASHBOARD_COOKIE_SECRET=
# Use single quotes around comma-separated bcrypt entries in the actual env file.
DASHBOARD_USERS=''
API_HOSTNAME=
DASHBOARD_HOSTNAME=
ACME_EMAIL=
API_REQUESTS_PER_MINUTE=600
FEATURE_SOURCE=feast
